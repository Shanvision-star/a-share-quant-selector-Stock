{
  "name": "a-share-quant-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "A-share Quant desktop workspace",
  "main": "main.cjs",
  "author": "A-share Quant",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check workspace.cjs && node --test test/*.test.cjs",
    "prepack": "install-electron",
    "predist": "install-electron",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "local.ashare.quant",
    "productName": "A-share Quant",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "workspace.cjs",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/python", "to": "python" },
      { "from": "build/app", "to": "app-source" },
      { "from": "build/defaults", "to": "defaults" }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "A-share-Quant-Setup-${version}.exe",
      "shortcutName": "A-share Quant"
    },
    "portable": {
      "artifactName": "A-share-Quant-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
